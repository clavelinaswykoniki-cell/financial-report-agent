# SEC asks automated clients to identify themselves with a descriptive User-Agent.
# Use your own name/email or project contact before sharing the project.
SEC_USER_AGENT="financial-report-agent/0.1 your-name your-email@example.com"

# Optional: enable LangChain LLM summary mode.
# Choose one provider style.

# OpenAI
OPENAI_API_KEY=""
FIN_AGENT_MODEL="openai:gpt-4o-mini"

# DeepSeek OpenAI-compatible API
# DEEPSEEK_API_KEY=""
# FIN_AGENT_MODEL="deepseek:deepseek-chat"

# Any OpenAI-compatible endpoint
# FIN_AGENT_API_KEY=""
# FIN_AGENT_BASE_URL="https://api.example.com/v1"
# FIN_AGENT_MODEL="openai-compatible:your-model"
